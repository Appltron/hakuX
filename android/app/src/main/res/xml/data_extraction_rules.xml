<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and transfer from Android 12 (android:dataExtractionRules). The
     cloud gets the settings and choices (its quota is 25 MB: over it,
     nothing is backed up); a device-to-device transfer also takes the games'
     saves (the hard disk's E: drive, Partition1). Neither takes the caches,
     savestates, logs, drivers or the console files the user supplied
     (console/). -->
<data-extraction-rules>
  <cloud-backup>
    <include domain="sharedpref" path="." />
    <include domain="file" path="controllers.json" />
    <include domain="file" path="mod_choices.json" />
  </cloud-backup>
  <device-transfer>
    <include domain="sharedpref" path="." />
    <include domain="file" path="controllers.json" />
    <include domain="file" path="mod_choices.json" />
    <include domain="file" path="native/hdd/Partition1/" />
  </device-transfer>
</data-extraction-rules>
