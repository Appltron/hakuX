<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup before Android 12 (android:fullBackupContent): the settings
     and choices, small enough for the 25 MB quota (over it, nothing is
     backed up). Not the hard disk's caches, savestates, logs, drivers or the
     console files the user supplied (console/). -->
<full-backup-content>
  <include domain="sharedpref" path="." />
  <include domain="file" path="controllers.json" />
  <include domain="file" path="mod_choices.json" />
</full-backup-content>
